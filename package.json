{
  "name": "infoscript-back",
  "version": "2.0.0",
  "description": "API REST completa para rede social acadêmica com autenticação JWT, gerenciamento de matérias, postagens e sistema de seguir/seguidores",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "type-check": "tsc --noEmit",
    "seed:materias": "tsx scripts/seed-materias.ts"
  },
  "keywords": [
    "fastify",
    "mongodb",
    "typescript",
    "jwt",
    "rest-api",
    "social-network",
    "academic",
    "backend"
  ],
  "author": "InfoScript Team",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/env": "^4.3.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.3.1",
    "fastify": "^5.6.2",
    "mongodb": "^6.3.0",
    "pino-pretty": "^10.3.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
